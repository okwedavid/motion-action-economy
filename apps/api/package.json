{
  "name": "@motion/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOTION backend API — Move. Prove. Earn.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:unit": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=1 \"src/**/*.unit.test.ts\"",
    "test:integration": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "pg-mem": "^2.9.0",
    "prettier": "^3.3.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
