# ============================================================================
# MOTION — environment variable reference
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# Server / general
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the API (used for links, CORS, webhook callbacks)
APP_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# PostgreSQL connection string (Supabase / hosted / local)
# Example Supabase: postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motion

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# High-entropy random string used to sign session tokens (>= 32 chars)
SESSION_SECRET=change-me-to-a-long-random-secret
# Session token lifetime (e.g. 7d)
SESSION_TTL=7d

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed browser origins. Never use "*".
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# ---------------------------------------------------------------------------
# BMONI (server-side ONLY — never expose to Flutter / web clients)
# ---------------------------------------------------------------------------
# Mode: mock (default, no network) | sandbox (dev env) | live (production)
BMONI_MODE=mock
# Sandbox: https://embedded-dev.bmoni.com  Production: https://embedded.bmoni.com
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# Production/partner API key. Required when BMONI_MODE=live.
BMONI_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: public dev sandbox key supplied out-of-band (BMONI dev docs). This is
# intentionally NOT committed in source; set it only if you need sandbox mode.
# BMONI_DEMO_SANDBOX_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret used to verify inbound BMONI webhooks (from BMONI webhook config)
BMONI_WEBHOOK_SECRET=change-me-webhook-secret
# Optional: partnerId for partner-scoped webhook subscriptions
BMONI_PARTNER_ID=

# ---------------------------------------------------------------------------
# Demo / sandbox mode
# Set to "true" to enable clearly-labelled demo presentation flows.
# ---------------------------------------------------------------------------
DEMO_MODE=true
